# Copie para .env e ajuste. Nenhum valor daqui é segredo; a única chave (API_CHAVE) fica vazia por padrão.

# LLM local (Ollama). No docker compose o endereço é http://ollama:11434
OLLAMA_URL=http://127.0.0.1:11434
MODELO_LLM=gemma3:4b
MODELO_EMBEDDING=bge-m3
TEMPERATURA=0
SEMENTE=42
NUM_CTX=4096

# Busca
TOP_K=3
PESO_VETORIAL=0.6
# LIMIAR_RECUSA=0.55   # só para experimentos; o padrão é o calibrado em avaliacao/limiar.json

# Integração com o componente Dados (export público da camada Ouro)
MAPA_URL=https://felipevoidela.github.io/GS2-2026-Big-Data-Architecture/dados/mapa_cidadao.json

# API
API_PORTA=8000
API_CHAVE=
API_ORIGENS=*
API_MAX_PERGUNTA=500
API_LIMITE_POR_MINUTO=20
